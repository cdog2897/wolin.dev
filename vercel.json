{
  "routes": [
    {
      "src": "^/(offers|social-media-management|web-design|service-areas)/index\\.html$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/90-day-hands-free-local-sensation/?$",
      "headers": {
        "Location": "/offers"
      },
      "status": 308
    },
    {
      "src": "^/.*$",
      "has": [
        {
          "type": "host",
          "value": "admin.wolin.dev"
        }
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/(admin|admin-preview|sign|sample|api)(/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/(private-shell|app-shell)\\.html$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/robots\\.txt$",
      "has": [
        {
          "type": "host",
          "value": "admin.wolin.dev"
        }
      ],
      "dest": "/admin-robots.txt"
    },
    {
      "src": "^/((offers|social-media-management|web-design|service-areas)(/index\\.html|/)?)?$",
      "has": [
        {
          "type": "host",
          "value": "admin.wolin.dev"
        }
      ],
      "dest": "/private-shell.html"
    },
    {
      "src": "^/(offers|social-media-management|web-design|service-areas)/?$",
      "dest": "/$1/index.html"
    },
    {
      "src": "^/calebwolin/?$",
      "dest": "/app-shell.html"
    },
    {
      "src": "^/(admin|sample)/?$",
      "dest": "/private-shell.html"
    },
    {
      "src": "^/sign/(.*)$",
      "dest": "/private-shell.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
